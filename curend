<script>
    // Тема, меню, навигация, ползунок прокрутки
    const themeToggle = document.getElementById('themeToggle');
    if (localStorage.getItem('crdTheme') === 'blue') { themeToggle.checked = true; document.body.classList.add('blue-theme'); }
    themeToggle.addEventListener('change', function() { if(this.checked) { document.body.classList.add('blue-theme'); localStorage.setItem('crdTheme', 'blue'); } else { document.body.classList.remove('blue-theme'); localStorage.setItem('crdTheme', 'red'); } });

    const menuIcon = document.getElementById('menuIcon'), overlay = document.getElementById('overlay'), sideMenu = document.getElementById('sideMenu'), closeMenuBtn = document.getElementById('closeMenu');
    function openMenu() { sideMenu.classList.add('open'); overlay.style.display = 'block'; document.body.style.overflow = 'hidden'; }
    function closeMenuFunc() { sideMenu.classList.remove('open'); overlay.style.display = 'none'; document.body.style.overflow = ''; }
    menuIcon.addEventListener('click', openMenu); closeMenuBtn.addEventListener('click', closeMenuFunc); overlay.addEventListener('click', closeMenuFunc);
    
    const mainContent = document.getElementById('mainContent'), aboutContent = document.getElementById('aboutContent'), riseContent = document.getElementById('riseContent'), playlistContent = document.getElementById('playlistContent'), scheduleContent = document.getElementById('scheduleContent'), feedbackContent = document.getElementById('feedbackContent'), gameContent = document.getElementById('gameContent');
    function showMain() { mainContent.style.display = 'block'; aboutContent.style.display = 'none'; riseContent.style.display = 'none'; playlistContent.style.display = 'none'; scheduleContent.style.display = 'none'; feedbackContent.style.display = 'none'; gameContent.style.display = 'none'; closeMenuFunc(); }
    function showAbout() { mainContent.style.display = 'none'; aboutContent.style.display = 'block'; riseContent.style.display = 'none'; playlistContent.style.display = 'none'; scheduleContent.style.display = 'none'; feedbackContent.style.display = 'none'; gameContent.style.display = 'none'; closeMenuFunc(); }
    function showRise() { mainContent.style.display = 'none'; aboutContent.style.display = 'none'; riseContent.style.display = 'flex'; playlistContent.style.display = 'none'; scheduleContent.style.display = 'none'; feedbackContent.style.display = 'none'; gameContent.style.display = 'none'; closeMenuFunc(); }
    function showPlaylist() { mainContent.style.display = 'none'; aboutContent.style.display = 'none'; riseContent.style.display = 'none'; playlistContent.style.display = 'block'; scheduleContent.style.display = 'none'; feedbackContent.style.display = 'none'; gameContent.style.display = 'none'; closeMenuFunc(); }
    function showSchedule() { mainContent.style.display = 'none'; aboutContent.style.display = 'none'; riseContent.style.display = 'none'; playlistContent.style.display = 'none'; scheduleContent.style.display = 'block'; feedbackContent.style.display = 'none'; gameContent.style.display = 'none'; closeMenuFunc(); }
    function showFeedback() { mainContent.style.display = 'none'; aboutContent.style.display = 'none'; riseContent.style.display = 'none'; playlistContent.style.display = 'none'; scheduleContent.style.display = 'none'; feedbackContent.style.display = 'block'; gameContent.style.display = 'none'; closeMenuFunc(); }
    function showGames() { mainContent.style.display = 'none'; aboutContent.style.display = 'none'; riseContent.style.display = 'none'; playlistContent.style.display = 'none'; scheduleContent.style.display = 'none'; feedbackContent.style.display = 'none'; gameContent.style.display = 'block'; closeMenuFunc(); }
    document.querySelectorAll('.menu-item, .special-menu-item, .rise-menu-item').forEach(item => { item.addEventListener('click', (e) => { e.preventDefault(); const page = item.getAttribute('data-page'); if (page === 'rise') showRise(); else if (page === 'about') showAbout(); else if (page === 'playlist') showPlaylist(); else if (page === 'schedule') showSchedule(); else if (page === 'feedback') showFeedback(); else if (page === 'games') showGames(); else { showMain(); if (item.getAttribute('href') && item.getAttribute('href') !== '#') { const targetId = item.getAttribute('href').substring(1); const targetElement = document.getElementById(targetId); if (targetElement) targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' }); } } }); });
    document.getElementById('cornerArrow').addEventListener('click', (e) => { e.preventDefault(); showAbout(); });
    document.getElementById('riseIcon').addEventListener('click', (e) => { e.preventDefault(); document.getElementById('riseContent').scrollIntoView({ behavior: 'smooth' }); showRise(); });
    showMain();

    // Вертикальный ползунок прокрутки в меню
    const scrollSlider = document.getElementById('pageScrollSlider');
    if (scrollSlider) {
        function updateScrollSlider() {
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            if (docHeight <= 0) return;
            const scrollPercent = (window.scrollY / docHeight) * 100;
            scrollSlider.value = scrollPercent;
        }
        window.addEventListener('scroll', updateScrollSlider);
        scrollSlider.addEventListener('input', function() {
            const percent = parseFloat(this.value) / 100;
            const targetY = percent * (document.documentElement.scrollHeight - window.innerHeight);
            window.scrollTo({ top: targetY, behavior: 'smooth' });
        });
        updateScrollSlider();
    }

    // Аудиоплеер (сокращён, но полностью рабочий)
    const audio = document.getElementById('bgMusic');
    const playPauseBtn = document.getElementById('musicPlayerBtn');
    const prevBtn = document.getElementById('prevTrackBtn');
    const nextBtn = document.getElementById('nextTrackBtn');
    const progressBar = document.getElementById('progressBar');
    const currentTimeSpan = document.getElementById('currentTime');
    const durationSpan = document.getElementById('duration');
    const trackNameSpan = document.getElementById('currentTrackName');
    const trackSourceSpan = document.getElementById('currentTrackSource');
    let currentTracksList = [], currentTrackIndex = -1;
    const floatingPlayer = document.getElementById('floatingPlayer');
    const collapseBtn = document.getElementById('collapsePlayerBtn');
    collapseBtn.addEventListener('click', () => { floatingPlayer.classList.toggle('collapsed'); const icon = collapseBtn.querySelector('i'); if (floatingPlayer.classList.contains('collapsed')) { icon.classList.remove('fa-chevron-down'); icon.classList.add('fa-chevron-up'); } else { icon.classList.remove('fa-chevron-up'); icon.classList.add('fa-chevron-down'); } });
    function formatTime(seconds) { if (isNaN(seconds)) return '0:00'; const mins = Math.floor(seconds / 60); const secs = Math.floor(seconds % 60); return `${mins}:${secs < 10 ? '0' : ''}${secs}`; }
    function updatePlayerInfo(title, source, durationSec) { trackNameSpan.textContent = title || 'Не выбрано'; trackSourceSpan.textContent = source || '—'; if (durationSec) { durationSpan.textContent = formatTime(durationSec); progressBar.max = durationSec; } else { durationSpan.textContent = '0:00'; progressBar.max = 0; } }
    function updateAllPlayIcons() { const currentUrl = audio.src; const isPlaying = !audio.paused; document.querySelectorAll('.track-list tr').forEach(row => { const playTd = row.querySelector('.track-play'); if (!playTd) return; const url = row.getAttribute('data-url'); if (url && url !== '#' && currentUrl.includes(url)) { playTd.innerHTML = isPlaying ? '<i class="fas fa-pause"></i>' : '<i class="fas fa-play"></i>'; } else { playTd.innerHTML = '<i class="fas fa-play"></i>'; } }); }
    function loadTrack(index, autoplay = true) { if (!currentTracksList.length || index < 0 || index >= currentTracksList.length) return; const track = currentTracksList[index]; if (track.url === '#') { alert('Трек пока не добавлен. Скоро появится!'); return; } audio.src = track.url; audio.load(); if (autoplay) { audio.play().then(() => { playPauseBtn.innerHTML = '<i class="fas fa-pause"></i>'; updatePlayerInfo(track.title, track.source, track.duration); currentTrackIndex = index; updateAllPlayIcons(); }).catch(() => {}); } else { updatePlayerInfo(track.title, track.source, track.duration); currentTrackIndex = index; updateAllPlayIcons(); } }
    function nextTrack() { if (!currentTracksList.length) return; let ni = currentTrackIndex + 1; if (ni >= currentTracksList.length) ni = 0; loadTrack(ni, true); }
