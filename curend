        else if(e.type === 'cartridge_yellow') { ctx.fillStyle = '#ffcc00'; ctx.fillRect(e.x-10, e.y-10, 20, 20); ctx.fillStyle = '#cc9900'; ctx.beginPath(); ctx.moveTo(e.x, e.y-14); ctx.lineTo(e.x-8, e.y); ctx.lineTo(e.x+8, e.y); ctx.fill(); ctx.fillStyle = '#000'; ctx.fillRect(e.x-4, e.y-4, 8, 8); }
    }
    function drawProjectile(p) { ctx.fillStyle = '#e0e0e0'; ctx.shadowBlur = 4; ctx.beginPath(); ctx.arc(p.x, p.y, 5, 0, Math.PI*2); ctx.fill(); ctx.shadowBlur = 0; }
    function drawGame() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#1a2a1f'; ctx.fillRect(0, 0, canvas.width, canvas.height);
        enemies.forEach(e => drawEnemy(e));
        projectiles.forEach(p => drawProjectile(p));
        drawSpiderMan(spiderX);
        if(bossActive) drawGreenGoblin(bossX, bossY);
    }
    function shootSingle(x, angleOffset = 0) { if(!active || gameFinished) return; let speedY = 9; let speedX = Math.sin(angleOffset) * 3.5; projectiles.push({ x, y: canvas.height-50, radius: 5, speedX, speedY }); }
    function shootSpread() { shootSingle(spiderX, -0.5); shootSingle(spiderX, 0); shootSingle(spiderX, 0.5); }
    function shootSuperSpread() { for(let i=0;i<5;i++) setTimeout(() => { if(active && !gameFinished && Date.now() < superSpreadEnd) shootSpread(); }, i*40); }
    function shootNormal() { shootSingle(spiderX, 0); }
    function shootRapid() { for(let i=0;i<5;i++) setTimeout(() => shootNormal(), i*40); }
    
    function handleShootAt(clientX, clientY) {
        if(!active || gameFinished) return;
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const clickX = (clientX - rect.left) * scaleX;
        if(Math.abs(clickX - spiderX) < 45) {
            const now = Date.now();
            if(now < superSpreadEnd) shootSuperSpread();
            else if(now < rapidEnd) shootRapid();
            else if(now < spreadEnd) shootSpread();
            else shootNormal();
        }
    }
    canvas.addEventListener('click', (e) => { handleShootAt(e.clientX, e.clientY); });
    canvas.addEventListener('mousemove', (e) => {
        if(!active || gameFinished) return;
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        let mouseX = (e.clientX - rect.left) * scaleX;
        mouseX = Math.min(Math.max(mouseX, 40), canvas.width-40);
        spiderX = mouseX;
    });
    canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        const touch = e.touches[0];
        handleShootAt(touch.clientX, touch.clientY);
    });
    canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        if(!active || gameFinished) return;
        const touch = e.touches[0];
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        let touchX = (touch.clientX - rect.left) * scaleX;
        touchX = Math.min(Math.max(touchX, 40), canvas.width-40);
        spiderX = touchX;
    });
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    
    function updateTimers() { let now = Date.now(); document.getElementById('rapidFireTimer').innerHTML = (now < rapidEnd) ? `🔥 ${Math.ceil((rapidEnd-now)/1000)}с` : '⚡'; document.getElementById('slowMotionTimer').innerHTML = (now < slowEnd) ? `🐢 ${Math.ceil((slowEnd-now)/1000)}с` : '⏳'; let spreadSpan = document.getElementById('spreadTimer'); if(now < spreadEnd) spreadSpan.innerHTML = `🔱 ${Math.ceil((spreadEnd-now)/1000)}с`; else spreadSpan.innerHTML = '🔱'; }
    function activateRapid() { rapidEnd = Date.now()+5000; if(rapidInterval) clearInterval(rapidInterval); rapidInterval = setInterval(updateTimers,200); }
    function activateSlow() { slowEnd = Date.now()+5000; if(slowInterval) clearInterval(slowInterval); slowInterval = setInterval(updateTimers,200); currentCartridgeChance = 0.1; setTimeout(() => { if(Date.now() >= slowEnd) currentCartridgeChance = normalCartridgeChance; }, 5000); }
    function activateSpread() { spreadEnd = Date.now()+5000; if(spreadInterval) clearInterval(spreadInterval); spreadInterval = setInterval(updateTimers,200); }
    function startBoss() { if(bossActive || gameFinished) return; bossActive = true; bossMaxHealth = getBossHealthByIndex(bossCycleIndex); bossHealth = bossMaxHealth; bossX = 50; bossY = 45; bossDir = 2; if(bossTimer) clearTimeout(bossTimer); bossTimer = setTimeout(() => { if(bossActive && !gameFinished) bossActive = false; }, 20000); ctx.font = 'bold 20px Inter'; ctx.fillStyle = '#ff3300'; ctx.fillText(`ЗЛОЙ ГОБЛИН (${bossMaxHealth} HP)`, canvas.width/2-150, 70); setTimeout(()=>drawGame(), 1500); }
    function updateGame() {
        if(!active || gameFinished) return;
        updateTimers(); let now = Date.now(); let speedMult = (now < slowEnd) ? 0.5 : 1.0; let delay = Math.max(28, baseDelay - Math.floor(score/20)*2);
        if(!bossActive) { spawnCounter++; if(spawnCounter >= delay) { spawnCounter = 0; let rad = 14; let spd = (1.8 + level*0.3) * speedMult; let r = Math.random(); let type = 'pumpkin'; if(r < currentCartridgeChance) { let sub = Math.random(); if(sub < 0.33) type = 'cartridge_red'; else if(sub < 0.66) type = 'cartridge_blue'; else type = 'cartridge_yellow'; } enemies.push({ x: 30+Math.random()*(canvas.width-60), y: -rad, radius: rad, speed: spd, type, diagonal: false }); } }
        let newLevel = Math.floor(score/10)+1; if(newLevel > level) { level = newLevel; document.getElementById('bombLevel').innerText = level; } if(level % 5 === 0 && level > 0 && !bossActive && score>0 && !gameFinished) startBoss();
        if(bossActive) { bossX += bossDir; if(bossX < 50 || bossX > canvas.width-50) bossDir = -bossDir; if(now - lastBossAttack > 400) { lastBossAttack = now; const angles = [-0.7, 0, 0.7]; for(let ang of angles) { let speedX = Math.sin(ang) * 4.2; let speedY = 3.0; enemies.push({ x: bossX, y: bossY + 15, radius: 14, speedX, speedY, type: 'pumpkin', diagonal: true }); } } }
        for(let i=0;i<projectiles.length;i++) { let p = projectiles[i]; p.x += p.speedX || 0; p.y -= p.speedY; if(p.x+5 < 0 || p.x-5 > canvas.width || p.y+5 < 0) { projectiles.splice(i,1); i--; } }
        if(bossActive) { for(let i=0;i<projectiles.length;i++) { let p = projectiles[i]; if(Math.abs(p.x - bossX) < 30 && Math.abs(p.y - bossY) < 40) { bossHealth--; projectiles.splice(i,1); if(bossHealth <= 0) { bossActive = false; score += 10; lives = Math.min(lives+2, 9); document.getElementById('bombScore').innerText = score; document.getElementById('bombLives').innerText = lives; if(bossTimer) clearTimeout(bossTimer); bossCycleIndex = (bossCycleIndex + 1) % 5; } break; } } }
        if(bossActive) { const spiderLeft = spiderX-32, spiderRight = spiderX+32, spiderTop = canvas.height-54, spiderBottom = canvas.height-14; const bossLeft = bossX-35, bossRight = bossX+35, bossTop = bossY-45, bossBottom = bossY+15; const collideBoss = (spiderRight > bossLeft && spiderLeft < bossRight && spiderBottom > bossTop && spiderTop < bossBottom); if(collideBoss) { lives--; document.getElementById('bombLives').innerText = lives; if(lives <= 0) { gameOver(); return; } bossX += (bossX < spiderX) ? -30 : 30; bossX = Math.min(Math.max(bossX, 40), canvas.width-40); resetCombo(); } }
        for(let i=0;i<enemies.length;i++) { let e = enemies[i]; if(e.diagonal) { e.x += e.speedX; e.y += e.speedY; } else { e.y += e.speed; }
            const spiderLeft = spiderX-32, spiderRight = spiderX+32, spiderTop = canvas.height-54, spiderBottom = canvas.height-14; const enemyLeft = e.x-e.radius, enemyRight = e.x+e.radius, enemyTop = e.y-e.radius, enemyBottom = e.y+e.radius; const collides = (enemyRight > spiderLeft && enemyLeft < spiderRight && enemyBottom > spiderTop && enemyTop < spiderBottom);
            if(collides) { if(e.type === 'pumpkin') { lives--; document.getElementById('bombLives').innerText = lives; if(lives <= 0) { gameOver(); return; } resetCombo(); } else { if(e.type === 'cartridge_red') { score+=2; lives=Math.min(lives+1,9); activateRapid(); } else if(e.type === 'cartridge_blue') { score+=2; lives=Math.min(lives+1,9); activateSpread(); } else if(e.type === 'cartridge_yellow') { score+=2; lives=Math.min(lives+1,9); activateSlow(); } document.getElementById('bombScore').innerText = score; document.getElementById('bombLives').innerText = lives; } enemies.splice(i,1); i--; continue; }
            let outOfBounds = false; if(e.diagonal) { if(e.x + e.radius < 0 || e.x - e.radius > canvas.width || e.y + e.radius > canvas.height) outOfBounds = true; } else { if(e.y + e.radius >= canvas.height - 10) outOfBounds = true; } if(outOfBounds) { if(!bossActive && e.type === 'pumpkin') { lives--; document.getElementById('bombLives').innerText = lives; if(lives <= 0) { gameOver(); return; } resetCombo(); } enemies.splice(i,1); i--; continue; }
            let hit = false; for(let j=0;j<projectiles.length;j++) { let p = projectiles[j]; if(Math.hypot(p.x - e.x, p.y - e.y) < e.radius + p.radius) { hit = true; projectiles.splice(j,1); if(e.type === 'pumpkin') { score++; addPumpkinHit(); } else if(e.type === 'cartridge_red') { score+=2; lives=Math.min(lives+1,9); activateRapid(); } else if(e.type === 'cartridge_blue') { score+=2; lives=Math.min(lives+1,9); activateSpread(); } else if(e.type === 'cartridge_yellow') { score+=2; lives=Math.min(lives+1,9); activateSlow(); } document.getElementById('bombScore').innerText = score; document.getElementById('bombLives').innerText = lives; let lvl = Math.floor(score/10)+1; if(lvl > level) { level = lvl; document.getElementById('bombLevel').innerText = level; } enemies.splice(i,1); i--; break; } } }
        drawGame(); anim = requestAnimationFrame(updateGame);
    }
    function gameOver() { if(active && !gameFinished) { active = false; gameFinished = true; if(rapidInterval) clearInterval(rapidInterval); if(slowInterval) clearInterval(slowInterval); if(spreadInterval) clearInterval(spreadInterval); if(bossTimer) clearTimeout(bossTimer); if(gameTimerInterval) clearInterval(gameTimerInterval); cancelAnimationFrame(anim); drawGame(); ctx.fillStyle = 'rgba(0,0,0,0.8)'; ctx.fillRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = '#ff4444'; ctx.font = 'bold 32px Inter'; ctx.fillText('💀 ВЫ ПРОИГРАЛИ 💀', canvas.width/2-160, canvas.height/2-40); ctx.font = 'bold 24px Inter'; ctx.fillStyle = '#ffffff'; ctx.fillText(`Очков: ${score}`, canvas.width/2-70, canvas.height/2+30); } }
    function startGame() {
        if(gameTimerInterval) clearInterval(gameTimerInterval); if(anim) cancelAnimationFrame(anim); if(rapidInterval) clearInterval(rapidInterval); if(slowInterval) clearInterval(slowInterval); if(spreadInterval) clearInterval(spreadInterval); if(bossTimer) clearTimeout(bossTimer);
        active = true; gameFinished = false; score = 0; lives = 3; level = 1; enemies = []; projectiles = []; spawnCounter = 0; spiderX = canvas.width/2; rapidEnd = 0; slowEnd = 0; spreadEnd = 0; superSpreadEnd = 0; pumpkinHitCombo = 0; updateComboDisplay(); bossActive = false; bossCycleIndex = 0; lastBossAttack = 0; currentCartridgeChance = normalCartridgeChance;
        document.getElementById('bombScore').innerText = '0'; document.getElementById('bombLives').innerText = '3'; document.getElementById('bombLevel').innerText = '1'; updateTimers(); gameStartTime = Date.now(); gameTimerInterval = setInterval(() => updateGameTimerDisplay(), 200); updateGameTimerDisplay(); anim = requestAnimationFrame(updateGame);
    }
    function resetGame() { if(gameTimerInterval) clearInterval(gameTimerInterval); if(anim) cancelAnimationFrame(anim); if(rapidInterval) clearInterval(rapidInterval); if(slowInterval) clearInterval(slowInterval); if(spreadInterval) clearInterval(spreadInterval); if(bossTimer) clearTimeout(bossTimer); active = false; gameFinished = false; score = 0; lives = 3; level = 1; enemies = []; projectiles = []; spiderX = canvas.width/2; rapidEnd = 0; slowEnd = 0; spreadEnd = 0; superSpreadEnd = 0; pumpkinHitCombo = 0; updateComboDisplay(); bossActive = false; bossCycleIndex = 0; lastBossAttack = 0; currentCartridgeChance = normalCartridgeChance; document.getElementById('bombScore').innerText = '0'; document.getElementById('bombLives').innerText = '3'; document.getElementById('bombLevel').innerText = '1'; updateTimers(); drawGame(); ctx.fillStyle = '#ff0033'; ctx.font = '18px Inter'; ctx.fillText('Нажми "Старт"', canvas.width/2-70, canvas.height/2); document.getElementById('gameTimer').innerText = '05:00'; }
    document.getElementById('startBombBtn').addEventListener('click', startGame);
    document.getElementById('resetBombBtn').addEventListener('click', resetGame);
    resetGame();
