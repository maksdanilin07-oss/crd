<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>CRD | Официальный сайт сообщества</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(145deg, #0a0c10 0%, #0f1117 100%);
            color: #f1f3f6;
            line-height: 1.5;
            scroll-behavior: smooth;
        }
        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 28px;
        }
        .hero {
            text-align: center;
            padding: 60px 0 40px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #ff0033;
            box-shadow: 0 15px 30px -10px rgba(0,0,0,0.6);
            margin-bottom: 20px;
        }
        h1 {
            font-size: 2.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #ffffff, #ff99aa);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            letter-spacing: -0.5px;
        }
        .bio {
            max-width: 650px;
            margin: 16px auto 0;
            color: #cbd0dd;
            font-size: 1.05rem;
        }
        .subtitle-left {
            font-size: 1.6rem;
            font-weight: 700;
            background: linear-gradient(135deg, #ffffff, #ff99aa);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            letter-spacing: -0.3px;
            margin: 30px 0 20px 0;
            text-align: left;
        }
        .links-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 16px;
            margin: 20px 0 50px;
        }
        .social-btn {
            background: rgba(20, 24, 32, 0.8);
            backdrop-filter: blur(8px);
            border-radius: 60px;
            padding: 12px 28px;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 600;
            font-size: 1rem;
            color: #fff;
            text-decoration: none;
            transition: all 0.2s ease;
            border: 1px solid rgba(255,255,255,0.15);
        }
        .social-btn i { font-size: 1.4rem; }
        .social-btn[data-platform="youtube"]:hover { background: #ff0000; border-color: #ff0000; transform: translateY(-3px); }
        .social-btn[data-platform="telegram"]:hover { background: #26a5e4; border-color: #26a5e4; transform: translateY(-3px); }
        .social-btn[data-platform="twitch"]:hover { background: #9146ff; transform: translateY(-3px); }
        .social-btn[data-platform="tiktok"]:hover { background: #000000; transform: translateY(-3px); }
        .social-btn[data-platform="dzen"]:hover { background: #2a3f54; transform: translateY(-3px); }
        .featured-video {
            margin: 30px 0 50px;
            background: #13161f;
            border-radius: 32px;
            padding: 25px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .section-title {
            font-size: 1.6rem;
            font-weight: 600;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .video-wrapper {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            border-radius: 20px;
            overflow: hidden;
        }
        .video-wrapper iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }
        .feed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 30px;
            margin: 40px 0 60px;
        }
        .feed-card {
            background: rgba(18, 22, 30, 0.9);
            backdrop-filter: blur(2px);
            border-radius: 28px;
            padding: 20px;
            border: 1px solid rgba(255,255,255,0.08);
            transition: transform 0.25s ease, box-shadow 0.25s;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }
        .feed-card:hover {
            transform: translateY(-6px);
            border-color: rgba(255,0,51,0.4);
            box-shadow: 0 20px 30px -10px rgba(0,0,0,0.5);
        }
        .feed-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .channel-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ff99aa;
            background: #1e1e2a;
        }
        .channel-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: -0.3px;
        }
        .channel-title small {
            font-size: 0.8rem;
            font-weight: normal;
            color: #ff99aa;
            margin-left: 6px;
        }
        .feed-list {
            list-style: none;
        }
        .feed-list li {
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .feed-list a {
            text-decoration: none;
            color: #eef2ff;
            font-weight: 500;
            display: block;
            transition: color 0.2s;
        }
        .feed-list a:hover { color: #ff4d6d; }
        .feed-date {
            font-size: 0.7rem;
            color: #8e95ab;
            margin-top: 5px;
            display: block;
        }
        .error-placeholder {
            color: #ff99aa;
            font-size: 0.9rem;
            padding: 12px 0;
        }
        .footer {
            text-align: center;
            padding: 40px 0;
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: 20px;
            font-size: 0.85rem;
            color: #ffffff;
            font-weight: 400;
        }
        @media (max-width: 760px) {
            .hero { padding: 40px 0 25px; }
            h1 { font-size: 2rem; }
            .subtitle-left { font-size: 1.3rem; }
            .social-btn { padding: 8px 20px; font-size: 0.85rem; }
            .feed-grid { grid-template-columns: 1fr; gap: 24px; }
            .container { padding: 0 18px; }
            .channel-avatar { width: 40px; height: 40px; }
            .channel-title { font-size: 1.1rem; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="hero">
        <img class="avatar" src="https://yt3.googleusercontent.com/ytc/APkrFKY2u2i-cZrWz1YhTKkMN_10WrwNtHGFfFkER2cK=s900-c-k-c0x00ffffff-no-rj" alt="Куренд" onerror="this.src='https://via.placeholder.com/120?text=CRD'">
        <h1>Официальный сайт сообщества CRD</h1>
        <div class="bio">
            Добро пожаловать! Это сообщество владельца канала Куренд, оно создано для удобного слежения за обновлениями разных каналов. Всё самое свежее — будет здесь.
        </div>
    </div>

    <div class="subtitle-left">Все видео, посты и стримы — можно найти тут:</div>

    <div class="links-grid" id="socialLinksContainer"></div>

    <div class="featured-video">
        <div class="section-title">
            <i class="fab fa-youtube" style="color:#ff0033;"></i> 
            <span>Последний выпуск</span>
        </div>
        <div class="video-wrapper">
            <iframe src="https://www.youtube.com/embed/eI0k3T9fYtU" title="Последнее видео" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>

    <div class="feed-grid">
        <!-- Дзен карточка (вместо Telegram) -->
        <div class="feed-card">
            <div class="feed-header">
                <img class="channel-avatar" id="dzenAvatar" src="https://cdn-icons-png.flaticon.com/512/5968/5968853.png" alt="Дзен">
                <div class="channel-title">Дзен <small>публикации</small></div>
            </div>
            <ul class="feed-list" id="dzenFeed">
                <li><i class="fas fa-spinner fa-pulse"></i> Загрузка статей...</li>
            </ul>
        </div>

        <!-- YouTube основной (@SGCuRend) -->
        <div class="feed-card">
            <div class="feed-header">
                <img class="channel-avatar" id="mainYTAvatar" src="https://yt3.googleusercontent.com/ytc/APkrFKY2u2i-cZrWz1YhTKkMN_10WrwNtHGFfFkER2cK=s48-c-k-c0x00ffffff-no-rj" alt="SGCuRend">
                <div class="channel-title">SGCuRend <small>основной</small></div>
            </div>
            <ul class="feed-list" id="youtubeFeedMain">
                <li><i class="fas fa-spinner fa-pulse"></i> Загрузка видео...</li>
            </ul>
        </div>

        <!-- YouTube второй (@curend) -->
        <div class="feed-card">
            <div class="feed-header">
                <img class="channel-avatar" id="secondaryYTAvatar" src="https://yt3.googleusercontent.com/ytc/AIdro_lcLxY8Fk8JpRZGfUqo2Hq3hKhJwH5wF1bE2LrG=s48-c-k-c0x00ffffff-no-rj" alt="CuRend">
                <div class="channel-title">CuRend <small>второй канал</small></div>
            </div>
            <ul class="feed-list" id="youtubeFeedSecondary">
                <li><i class="fas fa-spinner fa-pulse"></i> Загрузка видео...</li>
            </ul>
        </div>
    </div>

    <div class="footer">
        <i class="fab fa-youtube"></i> Все каналы сообщества CRD · Подписывайся и не пропускай новое
    </div>
</div>

<script>
    // ========= НАСТРОЙКИ =========
    // Ссылки на соцсети (кнопки)
    const socialLinks = [
        { name: "YouTube", icon: "fab fa-youtube", url: "https://youtube.com/@sgcurend", platform: "youtube" },
        { name: "Telegram", icon: "fab fa-telegram", url: "https://t.me/SGCuRend", platform: "telegram" },
        { name: "Twitch", icon: "fab fa-twitch", url: "https://www.twitch.tv/curendplayground", platform: "twitch" },
        { name: "TikTok", icon: "fab fa-tiktok", url: "https://www.tiktok.com/@_maxcrd_", platform: "tiktok" },
        { name: "Дзен", icon: "fas fa-newspaper", url: "https://dzen.ru/geekdigest?share_to=link", platform: "dzen" }
    ];

    // Аватарки каналов
    const channelAvatars = {
        mainYT: "https://yt3.googleusercontent.com/ytc/APkrFKY2u2i-cZrWz1YhTKkMN_10WrwNtHGFfFkER2cK=s48-c-k-c0x00ffffff-no-rj",
        secondaryYT: "https://yt3.googleusercontent.com/ytc/AIdro_lcLxY8Fk8JpRZGfUqo2Hq3hKhJwH5wF1bE2LrG=s48-c-k-c0x00ffffff-no-rj",
        dzen: "https://cdn-icons-png.flaticon.com/512/5968/5968853.png" // иконка Дзена, можно заменить
    };

    // ID каналов YouTube
    const MAIN_CHANNEL_ID = "UClfF0VgZ5WFNhwbCzjfDtDg";
    const SECONDARY_CHANNEL_ID = "UCgAVT1p1-BjzVTM848vGAyQ";
    const RSS_API_URL = "https://api.rss2json.com/v1/api.json?rss_url=";

    // Дзен: ссылка на канал (человеческая) и попытка получить RSS через rss-bridge
    const DZEN_CHANNEL_URL = "https://dzen.ru/geekdigest";
    // Пытаемся получить RSS через мост (если работает)
    const DZEN_RSS_URL = `https://rss-bridge.org/bridge01/?action=display&bridge=DzenBridge&url=${encodeURIComponent(DZEN_CHANNEL_URL)}&format=Atom`;
    // Если мост не работает, покажем ссылку на канал
    // =============================================

    function renderSocialLinks() {
        const container = document.getElementById("socialLinksContainer");
        if (!container) return;
        let html = "";
        for (let link of socialLinks) {
            html += `<a href="${link.url}" target="_blank" class="social-btn" data-platform="${link.platform}">
                        <i class="${link.icon}"></i> ${link.name}
                    </a>`;
        }
        container.innerHTML = html;
    }

    // Загрузка YouTube RSS
    async function loadYouTubeFeed(channelId, containerId, channelName) {
        const feedEl = document.getElementById(containerId);
        if (!feedEl) return;
        if (!channelId) {
            feedEl.innerHTML = `<li class="error-placeholder">⚠️ ID канала не указан.</li>`;
            return;
        }
        try {
            const rssUrl = `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`;
            const response = await fetch(`${RSS_API_URL}${encodeURIComponent(rssUrl)}`);
            const data = await response.json();
            if (data.status !== "ok" || !data.items) throw new Error();
            const items = data.items.slice(0, 4);
            let listHtml = "";
            items.forEach(item => {
                const title = item.title;
                const link = item.link;
                const pubDate = new Date(item.pubDate).toLocaleDateString("ru-RU");
                listHtml += `
                    <li>
                        <a href="${link}" target="_blank">${escapeHtml(title)}</a>
                        <span class="feed-date"><i class="far fa-calendar-alt"></i> ${pubDate}</span>
                    </li>
                `;
            });
            feedEl.innerHTML = listHtml;
        } catch (err) {
            feedEl.innerHTML = `<li class="error-placeholder">❌ Не удалось загрузить видео (${channelName}).</li>`;
        }
    }

    // Загрузка ленты Дзен (через RSS-мост)
    async function loadDzenFeed() {
        const feedEl = document.getElementById("dzenFeed");
        if (!feedEl) return;
        try {
            const response = await fetch(DZEN_RSS_URL);
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const text = await response.text();
            const parser = new DOMParser();
            const xmlDoc = parser.parseFromString(text, "application/xml");
            const parseError = xmlDoc.querySelector("parsererror");
            if (parseError) throw new Error("Ошибка парсинга RSS");
            const entries = xmlDoc.querySelectorAll("entry");
            if (!entries.length) throw new Error("Нет статей");
            const posts = Array.from(entries).slice(0, 4);
            let htmlPosts = "";
            posts.forEach(entry => {
                const titleElem = entry.querySelector("title");
                let title = titleElem ? titleElem.textContent.substring(0, 60) : "Новая статья";
                const linkElem = entry.querySelector("link");
                const link = linkElem ? linkElem.getAttribute("href") : DZEN_CHANNEL_URL;
                const updatedElem = entry.querySelector("updated");
                let pubDate = "Недавно";
                if (updatedElem && updatedElem.textContent) {
                    pubDate = new Date(updatedElem.textContent).toLocaleDateString("ru-RU");
                }
                htmlPosts += `
                    <li>
                        <a href="${link}" target="_blank">${escapeHtml(title)}</a>
                        <span class="feed-date"><i class="far fa-calendar-alt"></i> ${pubDate}</span>
                    </li>
                `;
            });
            feedEl.innerHTML = htmlPosts;
        } catch (err) {
            console.warn("Не удалось загрузить RSS Дзена", err);
            feedEl.innerHTML = `<li class="error-placeholder">
                                    📰 Не удалось загрузить свежие статьи автоматически.<br>
                                    <a href="${DZEN_CHANNEL_URL}" target="_blank" style="color:#ff99aa;">Перейти на канал Дзен →</a>
                                </li>`;
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, m => m === '&' ? '&amp;' : m === '<' ? '&lt;' : '&gt;');
    }

    function setAvatars() {
        const mainAvatar = document.getElementById("mainYTAvatar");
        const secondaryAvatar = document.getElementById("secondaryYTAvatar");
        const dzenAvatar = document.getElementById("dzenAvatar");
        if (mainAvatar) mainAvatar.src = channelAvatars.mainYT;
        if (secondaryAvatar) secondaryAvatar.src = channelAvatars.secondaryYT;
        if (dzenAvatar) dzenAvatar.src = channelAvatars.dzen;
    }

    function init() {
        renderSocialLinks();
        setAvatars();
        loadDzenFeed();
        loadYouTubeFeed(MAIN_CHANNEL_ID, "youtubeFeedMain", "SGCuRend");
        loadYouTubeFeed(SECONDARY_CHANNEL_ID, "youtubeFeedSecondary", "CuRend");
    }
    init();
</script>
</body>
</html>
